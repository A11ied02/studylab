```gitignore
# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
.next/
.nuxt/

# Local environment files
*.local
.env
.env.*
!.env.example
/src/services/firebase.ts

# IDEs and editors
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
```
